PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ejamia
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
# Optional dedicated secret for signed /uploads URLs (defaults to JWT_SECRET)
# UPLOAD_SIGNING_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Production: leave unset or false. Set to true only to allow public org signup.
ALLOW_SIGNUP=false
# Dev helper: return reset token in forgot-password JSON (also on when NODE_ENV !== production)
# PASSWORD_RESET_RETURN_TOKEN=true
# Optional: sync mongoose indexes on boot (recommended once after Phase 2 deploy)
# SYNC_INDEXES=true
SEED_TENANT_SLUG=main
SEED_ADMIN_USERNAME=admin123
SEED_ADMIN_PASSWORD=Admin@123
